# Copy to /mnt/us/aindle/hub.env on the Kindle.
# Kindle cannot use 127.0.0.1 — that is the Kindle itself.

# Replace with the Hub's LAN/Tailscale address before copying to Kindle.
HUB=http://192.168.1.2:8790
TOKEN=
PAGE=local
OPERATE=/monitor.html?device=oasis1&kindle=1
# Lock-screen refresh. Seconds. Idle 10 min, busy (active tasks) 5 min.
LOCK_SEC=600
LOCK_BUSY_SEC=300
# Max rtcWakeup. Kindle only accepts this property in readyToSuspend.
LOCK_HEARTBEAT_SEC=600
# Leave Wi-Fi up after a frame until readyToSuspend. Suspend always turns
# the radio off so the next wake can associate cleanly. 1 = more battery.
LOCK_HOLD_WIFI=0
# Seconds to wait for cmState=CONNECTED after turning the radio on.
LOCK_WIFI_WAIT_SEC=30
